# Copy this file to ".env" and fill in the values from Supabase:
# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# The address of the Node server (the "server" folder). Keep this while you work on your computer.
VITE_API_URL=http://localhost:3001
# Show the "Continue with Google" button? Set true only after you set up Google login in Supabase.
VITE_ENABLE_GOOGLE=false
