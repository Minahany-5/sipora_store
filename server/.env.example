# Copy this file to ".env" (inside the server folder) and fill in the values.
# NEVER put this file in Git. It has a SECRET key.

PORT=3001

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The SECRET key (service_role / "secret"). NOT the anon key. Only this server uses it.
SUPABASE_SERVICE_KEY=YOUR-SECRET-KEY
# Needed only by "npm run smoke" (the anon key, same as the website)
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# The website address(es) that may call this server. Separate with commas.
FRONTEND_URL=http://localhost:5173

# Emails (Resend). Leave RESEND_API_KEY empty to skip emails while you test.
RESEND_API_KEY=
EMAIL_FROM=Sipora <onboarding@resend.dev>
# You get a message here when a new order or payment proof arrives
ADMIN_EMAIL=minahany455@gmail.com

# Max orders one internet address can place in 15 minutes (protects you from spam)
ORDER_RATE_LIMIT=20
